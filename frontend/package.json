{
  "name": "momars-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "serve": "vite",
    "serve:dist": "node scripts/serve-dist.mjs",
    "build": "vite build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:mobile-performance": "node scripts/check-mobile-performance.mjs",
    "lint": "eslint --ext .js,.mjs,.vue src",
    "test:unit": "node --experimental-default-type=module --test node-tests/*.test.mjs",
    "test:coverage": "node --experimental-default-type=module --experimental-test-coverage --test --test-coverage-include=src/utils/*.mjs --test-coverage-include=src/features/**/*.mjs --test-coverage-include=src/plugins/icons.js --test-coverage-include=src/store/modules/*.mjs --test-coverage-include=src/router/*.mjs --test-coverage-include=src/services/*.mjs --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=100 node-tests/*.test.mjs",
    "audit:policy": "node scripts/check-dependency-audit.mjs",
    "test:e2e": "npm run test:e2e:dist",
    "test:e2e:dist": "node scripts/run-e2e.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "5.3.0",
    "@fontsource/tajawal": "5.3.0",
    "axios": "^1.19.0",
    "chart.js": "^4.5.0",
    "exceljs": "^4.4.0",
    "laravel-echo": "^1.17.1",
    "momars-workspace": "file:..",
    "pusher-js": "^8.6.0",
    "quill": "2.0.2",
    "vue": "3.5.41",
    "vue-router": "^4.6.4",
    "vue-toastification": "2.0.0-rc.5",
    "vuetify": "3.13.2",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^10.10.0",
    "lighthouse": "13.4.1",
    "sass": "^1.103.1",
    "vite": "^8.2.2",
    "vite-plugin-vuetify": "^2.1.3",
    "@vue/compiler-sfc": "3.5.41",
    "vue-eslint-parser": "^10.4.1"
  },
  "overrides": {
    "body-parser": "1.20.6",
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "cross-spawn": "^6.0.6",
    "fast-uri": "3.1.5",
    "http-proxy-middleware": "^2.0.10",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss@>=8 <9": "8.5.23",
    "serialize-javascript": "^7.0.5",
    "shell-quote": "1.10.0",
    "svgo": "2.8.3",
    "uuid": "^11.1.1",
    "websocket-driver": "^0.7.5",
    "webpack-dev-server": "5.2.6"
  }
}
