APP_NAME=Momars
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=momars
DB_USERNAME=momars_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=5256000
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080,example.com
SANCTUM_TOKEN_EXPIRATION=120
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

BROADCAST_CONNECTION=pusher
FILESYSTEM_DISK=local
ASSESSMENT_FILES_DISK=local
QUEUE_CONNECTION=database
HEALTH_MAX_ERRORS_5M=10
HEALTH_MAX_CLIENT_ERRORS_5M=20
HEALTH_MAX_PENDING_JOBS=1000
HEALTH_MAX_FAILED_JOBS=5

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VUE_APP_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VUE_APP_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VUE_APP_PUSHER_HOST="${PUSHER_HOST}"
VUE_APP_PUSHER_PORT="${PUSHER_PORT}"
VUE_APP_PUSHER_SCHEME="${PUSHER_SCHEME}"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
